@page "/HouseholdItems"
@attribute [Authorize]
@layout AppLayout
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using HomeHub.Web.Modules.Households
@using HomeHub.Web.Modules.HouseholdItems.Shared
@inject ManageCatalogue UseCase
@inject AuthenticationStateProvider Auth
@inject ILogger<Index> Logger
@inject IJSRuntime JS
<PageTitle>Household items</PageTitle>
<h1>Household Items Catalogue</h1>
<p><a href="/HouseholdItems/Planning">Planning totals</a> · <a href="/HouseholdItems/Archived">Archived items</a></p>
<p>Keep a shared list of non-food consumables such as toilet roll, shampoo, and laundry detergent.</p>
<fieldset class="household-item-controls" disabled="@(!interactiveReady || busy)" aria-label="Household item management">
    <div class="actions"><BbButton id="household-item-add" OnClick="Add" Disabled="busy">Add household item</BbButton><BbButton OnClick="Refresh" Disabled="busy">Refresh catalogue</BbButton></div>
    @if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
    @if (notice is not null) { <p role="status">@notice</p> }
    @if (items.Count == 0 && error is null) { <p>No household items yet. Add your first item to get started.</p> }
    @foreach (var item in items) {
        <div class="card" @key="item.Id">
            <HouseholdItemSummary Name="@item.Name" Unit="@item.Unit" ExpectedWeeklyUsage="item.ExpectedWeeklyUsage" />
            <div class="actions"><BbButton id="@($"household-item-edit-{item.Id}")" OnClick="() => Edit(item)" Disabled="busy">Edit</BbButton><BbButton OnClick="() => Archive(item)" Disabled="busy">Archive</BbButton></div>
        </div>
    }
</fieldset>
@if (input is not null) { <HouseholdItemEditor Input="input" ExistingItem="editingItem" Saved="Saved" Closed="Cancel" /> }
@code {
    private bool interactiveReady, busy;
    private ManageCatalogue.Request? input;
    private ManageCatalogue.Item? editingItem;
    private IReadOnlyList<ManageCatalogue.Item> items = [];
    private string? error, notice;
    private string focusTarget = "household-item-add";
    private bool restoreFocus;
    private IJSObjectReference? focusModule;
    protected override async Task OnInitializedAsync() => await Refresh();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { interactiveReady = true; StateHasChanged(); }
        if (restoreFocus && input is null && !busy) {
            restoreFocus = false;
            focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Modules/HouseholdItems/ManageCatalogue/Index.razor.js");
            await focusModule.InvokeVoidAsync("focusTrigger", focusTarget);
        }
    }
    private async Task Refresh() => await Run(async () => {
        items = await UseCase.ListAsync((await Auth.GetAuthenticationStateAsync()).User);
    });
    private void Add() { focusTarget = "household-item-add"; input = new(); editingItem = null; error = notice = null; }
    private void Edit(ManageCatalogue.Item item) { focusTarget = $"household-item-edit-{item.Id}"; editingItem = item; input = new() { Id = item.Id, Version = item.Version, Name = item.Name, Unit = item.Unit, ExpectedWeeklyUsage = item.ExpectedWeeklyUsage?.ToString("0.####") ?? "" }; error = notice = null; }
    private void Cancel() { notice = input?.Id is null ? "Add cancelled." : "Edit cancelled."; input = null; editingItem = null; restoreFocus = true; }
    private async Task Saved(Guid id)
    {
        input = null; editingItem = null;
        await Refresh();
        if (error is null) notice = "Household item saved.";
        restoreFocus = true;
    }
    private async Task Archive(ManageCatalogue.Item item) => await Run(async () => {
        var actor = (await Auth.GetAuthenticationStateAsync()).User;
        await UseCase.ArchiveAsync(actor, item.Id, item.Version);
        items = await UseCase.ListAsync(actor); notice = "Household item archived.";
    });
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; error = null; notice = null;
        try { await action(); }
        catch (HouseholdRuleException ex) { error = ex.Message; items = []; }
        catch (Exception ex) { Logger.LogError(ex, "Could not update household item catalogue."); error = "Could not update the catalogue. Please refresh and try again."; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        if (focusModule is null) return;
        try { await focusModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
