HOMEHUB_PORT=5293
# Use a SQL Server reachable from the container and a dedicated HomeHub database.
# Single quotes prevent Compose from interpreting dollar signs in credentials.
HOMEHUB_CONNECTION_STRING='Server=YOUR_SQL_SERVER,1433;Database=HomeHub;User Id=YOUR_SQL_LOGIN;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True'
