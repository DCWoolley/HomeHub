@page "/Meals"
@page "/Meals/{MealId:guid}/Recipe"
@attribute [Authorize]
@layout AppLayout
@using HomeHub.Web.Modules.Households
@using HomeHub.Web.Modules.MealPlanner.Shared
@inject ManageMeals UseCase
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation

<PageTitle>Meal list</PageTitle>
<div class="catalog-heading"><div><p class="eyebrow">Your household cookbook</p><h1>Your meals</h1><p>Favourite meals, with recipes ready when you need them.</p></div><a href="/MealPlanner">Meal planner →</a></div>
<fieldset class="catalog-controls meal-controls" disabled="@(!interactiveReady || busy)" aria-label="Meal management">
    <div class="catalog-toolbar"><div><label for="meal-search">Search meals</label><input id="meal-search" type="search" @bind="search" @bind:event="oninput" placeholder="Find a meal…" /></div><BbButton OnClick="Add">Add meal</BbButton></div>
    @if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
    @if (notice is not null) { <p role="status">@notice</p> }
    <p class="catalog-count">@meals.Count meal@(meals.Count == 1 ? "" : "s")</p>
    @if (meals.Count == 0) { <p class="catalog-empty">No meals yet. Add your first meal to get started.</p> }
    else if (!Filtered.Any()) { <p class="catalog-empty" role="status">No meals match your search.</p> }
    <div class="catalog-list">
        @foreach (var meal in Filtered) {
            <article class="catalog-entry" @key="meal.Id"><div><h2>@meal.Name</h2><p>Edit this meal and its recipe.</p></div><div class="actions"><BbButton Variant="ButtonVariant.Outline" Class="secondary" OnClick="() => Edit(meal.Id)">Edit</BbButton><BbButton Variant="ButtonVariant.Outline" Class="secondary" OnClick="() => Preview(meal.Id)">Delete</BbButton></div></article>
        }
    </div>
    @if (pending is not null) {
        <section class="alert" aria-label="Confirm meal deletion"><p>Delete <strong>@pending.Name</strong>? Its recipe will be deleted; ingredients stay in your list.</p>
            @if (pending.PlannedOccurrences > 0) { <p role="alert">This meal is used @pending.PlannedOccurrences time(s) in your schedule. Deleting it will also remove it from every slot in the schedule.</p> }
            <div class="actions"><BbButton OnClick="Delete">Confirm deletion</BbButton><BbButton Variant="ButtonVariant.Outline" Class="secondary" OnClick="() => pending = null">Cancel deletion</BbButton></div>
        </section>
    }
</fieldset>
@if (editorOpen) { <MealEditor @key="editorId" MealId="editorId" Saved="Saved" Closed="Closed" /> }

@code {
    [Parameter] public Guid? MealId { get; set; }
    private bool interactiveReady;
    private bool busy;
    private bool editorOpen;
    private Guid? editorId;
    private string search = "";
    private string? error;
    private string? notice;
    private IReadOnlyList<ManageMeals.Item> meals = [];
    private ManageMeals.Deletion? pending;
    private IEnumerable<ManageMeals.Item> Filtered => meals.Where(x => x.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));
    protected override async Task OnParametersSetAsync()
    {
        await Load();
        editorId = MealId; editorOpen = MealId is not null;
    }
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { interactiveReady = true; StateHasChanged(); } }
    private async Task Load() => await Run(async () => meals = await UseCase.ListAsync((await Auth.GetAuthenticationStateAsync()).User));
    private void Add() { editorId = null; editorOpen = true; pending = null; error = notice = null; }
    private void Edit(Guid id) { editorId = id; editorOpen = true; pending = null; error = notice = null; }
    private void Closed() { editorOpen = false; editorId = null; if (MealId is not null) Navigation.NavigateTo("/Meals", replace: true); }
    private async Task Saved() { Closed(); await Load(); notice = "Meal saved."; }
    private async Task Preview(Guid id) => await Run(async () => pending = await UseCase.PreviewDeleteAsync((await Auth.GetAuthenticationStateAsync()).User, id));
    private async Task Delete() => await Run(async () => {
        if (pending is null) return;
        var actor = (await Auth.GetAuthenticationStateAsync()).User;
        var confirmed = pending;
        pending = await UseCase.PreviewDeleteAsync(actor, confirmed.Id);
        await UseCase.DeleteAsync(actor, confirmed.Id, confirmed.PlannedOccurrences > 0);
        pending = null; meals = await UseCase.ListAsync(actor); notice = "Meal deleted.";
    });
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; error = null;
        try { await action(); } catch (HouseholdRuleException ex) { error = ex.Message; } finally { busy = false; }
    }
}
