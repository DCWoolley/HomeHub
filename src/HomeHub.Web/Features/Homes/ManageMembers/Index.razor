@page "/Home/Members"
@layout HomeHub.Web.Components.Layout.AppLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using HomeHub.Application.Features.Homes.ManageMembers
@inject IHomeMembers Homes

<PageTitle>Members | HomeHub</PageTitle>
<AccountCard Title="Home members" Description="Everyone who belongs to your home.">
    @if (home is null)
    {
        <p>Create or join a home first.</p>
    }
    else
    {
        <ul class="member-list">
            @foreach (var member in home.Members)
            {
                <li>
                    <div class="member-heading">
                        @if (member.Colour is not null)
                        {
                            <span class="member-colour" style="background-color: @member.Colour" aria-label="Colour @member.Colour"></span>
                        }
                        <strong>@member.DisplayName</strong>
                    </div>
                    <p>@(member.IsOwner ? "Owner" : member.IsAccountLinked ? "Account-linked member" : "Non-user member · no sign-in access")</p>
                    @if (home.IsOwner && !member.IsOwner)
                    {
                        <div class="member-actions">
                            @if (!member.IsAccountLinked)
                            {
                                <a href="Home/Members/Edit/@member.Id">Edit profile</a>
                            }
                            <a href="Home/Members/Remove/@member.Id">Remove member</a>
                        </div>
                    }
                </li>
            }
        </ul>
        @if (home.IsOwner)
        {
            <a class="btn" href="Home/Members/New">Add a non-user member</a>
            <p>For someone who needs their own sign-in, generate an invitation on <a href="Home">Your home</a>.</p>
        }
    }
    <p class="account-links"><a href="Home">Back to your home</a></p>
</AccountCard>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private MembersDetails? home;

    protected override async Task OnInitializedAsync() =>
        home = await Homes.GetMembersAsync(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!, HttpContext.RequestAborted);
}
