@page "/Meals"
@inject IMeals Meals

<PageTitle>Meals | HomeHub</PageTitle>
<AccountCard Title="Meals" Description="Your household favourites. Add a name, then plan when to have it.">
    @if (error is not null) { <p role="alert" class="validation-message">@error</p> }
    @if (meals is null)
    {
        <p><a href="Home">Create or join a home</a> to start your meal list.</p>
    }
    else
    {
        <p><a class="btn" href="Meals/New">Add a meal</a> · <a href="MealPlanner">Open meal planner</a></p>
        @if (meals.Count == 0) { <p>No meals yet. Add your first household favourite.</p> }
        <ul class="meal-list">
            @foreach (var meal in meals)
            {
                <li>
                    <div><strong>@meal.Name</strong><p>@(meal.PlannedDays.Count == 0 ? "Not planned" : string.Join(", ", meal.PlannedDays))</p></div>
                    <div><a href="Meals/Edit/@meal.Id">Edit</a> · <a href="Meals?delete=@meal.Id" data-enhance-nav="false">Delete</a></div>
                </li>
            }
        </ul>
        @if (deleting is not null)
        {
            <dialog open data-meal-dialog aria-labelledby="delete-title" aria-describedby="delete-warning">
                <h2 id="delete-title">Delete @deleting.Name?</h2>
                <p id="delete-warning">
                    @if (deleting.PlannedDays.Count > 0)
                    {
                        <span>This meal is planned on @string.Join(", ", deleting.PlannedDays). Deleting it also removes all its planner assignments and member selections.</span>
                    }
                    else { <span>This will permanently remove the meal from your list.</span> }
                </p>
                <EditForm Model="Delete" method="post" FormName="delete-meal" OnSubmit="DeleteMeal">
                    <input type="hidden" name="Delete.Id" value="@Delete.Id" />
                    <button type="submit">Delete meal</button>
                    <a href="Meals" data-enhance-nav="false">Cancel</a>
                </EditForm>
            </dialog>
        }
    }
</AccountCard>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "delete")] public Guid? DeleteId { get; set; }
    [SupplyParameterFromForm(FormName = "delete-meal")] private DeleteInput Delete { get; set; } = default!;
    private IReadOnlyList<MealDetails>? meals;
    private MealDetails? deleting;
    private string? error;
    private string UserId => HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

    protected override async Task OnInitializedAsync()
    {
        meals = await Meals.GetMealsAsync(UserId, HttpContext.RequestAborted);
        deleting = meals?.SingleOrDefault(meal => meal.Id == DeleteId);
        Delete ??= new() { Id = DeleteId ?? Guid.Empty };
    }

    private async Task DeleteMeal()
    {
        if (deleting is null || Delete.Id != deleting.Id) { error = "This meal is no longer available. Reload the meal list."; return; }
        error = await Meals.DeleteMealAsync(UserId, Delete.Id, HttpContext.RequestAborted);
        if (error is null) HttpContext.Response.Redirect("/Meals");
    }

    public sealed class DeleteInput { public Guid Id { get; set; } }
}
