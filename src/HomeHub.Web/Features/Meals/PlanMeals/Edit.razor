@page "/MealPlanner/Entry/{Id:guid}"
@inject IMealPlanner Planner
@inject IHomeMembers Members

<PageTitle>Planned meal | HomeHub</PageTitle>
<AccountCard Title="@(entry is null ? "Planned meal" : $"{entry.Name} · {entry.Day}")" Description="Choose members only when this meal is not for everyone.">
    @if (error is not null) { <p role="alert" class="validation-message">@error</p> }
    @if (entry is null) { <p>This planned meal is no longer available in your home.</p> }
    else
    {
        <EditForm Model="Input" method="post" FormName="meal-members" OnSubmit="Save">
            <fieldset>
                <legend>Who's having this meal?</legend>
                <p>No members selected means everyone. Clear all selections to return to everyone.</p>
                @for (var i = 0; i < Input.Choices.Count; i++)
                {
                    var index = i;
                    var member = members?.Members.SingleOrDefault(member => member.Id == Input.Choices[index].Id);
                    <div class="member-choice">
                        <input type="hidden" name="Input.Choices[@index].Id" value="@Input.Choices[index].Id" />
                        <InputCheckbox id="@($"member-{index}")" @bind-Value="Input.Choices[index].Selected" />
                        <label for="@($"member-{index}")">@(member?.DisplayName ?? "Former member (clear this selection)")</label>
                    </div>
                }
            </fieldset>
            <button type="submit">Save members</button>
        </EditForm>
        <hr />
        <EditForm Model="Removal" method="post" FormName="remove-planned-meal" OnSubmit="Remove">
            <p>Remove this meal from @entry.Day. It will remain in your meal list.</p>
            <button type="submit">Remove from day</button>
        </EditForm>
    }
    <p><a href="MealPlanner">Back to meal planner</a></p>
</AccountCard>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "meal-members")] private MembersInput Input { get; set; } = default!;
    private readonly object Removal = new();
    private PlannedMealDetails? entry;
    private MembersDetails? members;
    private string? error;
    private string UserId => HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
    protected override async Task OnInitializedAsync()
    {
        entry = (await Planner.GetPlanAsync(UserId, HttpContext.RequestAborted))?.SingleOrDefault(item => item.Id == Id);
        members = await Members.GetMembersAsync(UserId, HttpContext.RequestAborted);
        Input ??= new()
        {
            Choices = (members?.Members.Select(member => member.Id) ?? [])
                .Union(entry?.MemberIds ?? []).Select(id => new MemberChoice { Id = id, Selected = entry?.MemberIds.Contains(id) == true }).ToList()
        };
    }
    private async Task Save()
    {
        error = await Planner.SetMembersAsync(UserId, Id, Input.Choices.Where(choice => choice.Selected).Select(choice => choice.Id).ToArray(), HttpContext.RequestAborted);
        if (error is null) HttpContext.Response.Redirect("/MealPlanner");
    }
    private async Task Remove()
    {
        error = await Planner.RemoveMealAsync(UserId, Id, HttpContext.RequestAborted);
        if (error is null) HttpContext.Response.Redirect("/MealPlanner");
    }
    public sealed class MembersInput { public List<MemberChoice> Choices { get; set; } = []; }
    public sealed class MemberChoice
    {
        public Guid Id { get; set; }
        public bool Selected { get; set; }
    }
}
