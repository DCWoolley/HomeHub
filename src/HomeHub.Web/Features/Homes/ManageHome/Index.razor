@page "/Home"
@layout HomeHub.Web.Components.Layout.AppLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using HomeHub.Application.Features.Homes.ManageHome
@inject IHomeAccess Homes
@inject TimeProvider Clock

<PageTitle>Your home | HomeHub</PageTitle>

<AccountCard Title="@(home?.Name ?? "Your home")" Description="@(home is null ? "Create a home or join one with an invitation code." : home.IsOwner ? "You are the owner of this home." : "You are a member of this home.")">
    @if (error is not null)
    {
        <p role="alert" class="validation-message">@error</p>
    }
    @if (home is null)
    {
        <EditForm Model="Input" method="post" FormName="join-home" OnValidSubmit="JoinHome">
            <DataAnnotationsValidator />
            <ValidationSummary role="alert" />
            <HomeChoiceFields Input="Input" />
            <button type="submit">Continue</button>
        </EditForm>
    }
    else if (home.IsOwner)
    {
        <p>Invite someone to your home. Each code can be used once and expires after seven days.</p>
        <EditForm Model="Input" method="post" FormName="invite-home" OnSubmit="GenerateInvitation">
            <button type="submit">Generate invitation code</button>
        </EditForm>
        @if (invitation?.Code is { } code)
        {
            <div role="status" class="invitation-result">
                <p>Share this code with the person you want to invite. It is only shown now.</p>
                <code>@(code)</code>
                <p>Expires @invitation.ExpiresAt?.ToString("dd MMM yyyy HH:mm 'UTC'").</p>
            </div>
        }
        @if (invitations.Count > 0)
        {
            <h2>Invitations</h2>
            <EditForm Model="Revoke" method="post" FormName="revoke-invitation" OnSubmit="RevokeInvitation">
                <ul>
                    @foreach (var item in invitations)
                    {
                        <li>
                            Expires @item.ExpiresAt.ToString("dd MMM yyyy HH:mm 'UTC'") ·
                            @(item.Revoked ? "Revoked" : item.Used ? "Used" : item.ExpiresAt <= Clock.GetUtcNow() ? "Expired" : "Available")
                            @if (!item.Revoked && !item.Used && item.ExpiresAt > Clock.GetUtcNow())
                            {
                                <button type="submit" name="Revoke.Id" value="@item.Id">Revoke this invitation</button>
                            }
                        </li>
                    }
                </ul>
            </EditForm>
        }
    }
    @if (home is not null)
    {
        <p class="account-links"><a href="Home/Members">View and manage members</a></p>
        <p class="account-links"><a href="Home/Configure">@(home.IsOwner ? "Configure home" : "View floors and rooms")</a></p>
    }
    <p class="account-links"><a href="">Back to HomeHub</a></p>
</AccountCard>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private HomeChoiceInput Input { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "revoke-invitation")] private RevokeInput Revoke { get; set; } = default!;
    private IReadOnlyList<InvitationDetails> invitations = [];
    private HomeDetails? home;
    private InvitationResult? invitation;
    private string? error;
    private string UserId => HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        Revoke ??= new();
        home = await Homes.GetAsync(UserId, HttpContext.RequestAborted);
        invitations = await Homes.GetInvitationsAsync(UserId, HttpContext.RequestAborted);
    }

    private async Task JoinHome()
    {
        error = await Homes.JoinAsync(UserId, Input.ToChoice(), HttpContext.RequestAborted);
        home = await Homes.GetAsync(UserId, HttpContext.RequestAborted);
    }

    private async Task GenerateInvitation()
    {
        invitation = await Homes.InviteAsync(UserId, HttpContext.RequestAborted);
        error = invitation.Error;
        invitations = await Homes.GetInvitationsAsync(UserId, HttpContext.RequestAborted);
    }

    private async Task RevokeInvitation()
    {
        error = await Homes.RevokeInvitationAsync(UserId, Revoke.Id, HttpContext.RequestAborted);
        invitations = await Homes.GetInvitationsAsync(UserId, HttpContext.RequestAborted);
    }

    public sealed class RevokeInput { public Guid Id { get; set; } }
}
