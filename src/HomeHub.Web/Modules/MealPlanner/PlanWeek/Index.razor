@page "/MealPlanner"
@attribute [Authorize]
@layout AppLayout
@using HomeHub.Web.Modules.Households
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PlanWeek UseCase
@inject HomeHub.Web.Modules.MealPlanner.ManageMeals.ManageMeals MealList
@inject AuthenticationStateProvider Auth
@inject HomeHub.Web.Modules.MealPlanner.CreateMealFromPlanner.CreateMealFromPlanner CreateMeal
@inject HomeHub.Web.Modules.MealPlanner.ManagePlannerSettings.ManagePlannerSettings Settings
<PageTitle>Weekly meal planner</PageTitle>
<h1>Meal planner</h1>
<p>Your shared Monday–Sunday schedule stays the same until you change it. Add as many meals as you need to each slot.</p>
<p><a href="/Meals">Manage your meal list</a> · <a href="/MealPlanner/Settings">Planner settings</a></p>
<fieldset class="meal-controls" disabled="@(!interactiveReady)" aria-label="Weekly meal planning">
@if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
@if (message is not null) { <p class="alert" role="status">@message</p> }
<div class="actions"><BbButton OnClick="Refresh" Disabled="busy">Refresh schedule</BbButton></div>
@if (meals.Count == 0 && enabledSlots.Count > 0) { <p>Your meal list is empty. Create a meal in any slot below to start planning.</p> }
@if (enabledSlots.Count == 0) { <p>No meal slots are enabled. Choose your slots in <a href="/MealPlanner/Settings">planner settings</a>.</p> }
<div class="meal-week">
@foreach (var day in Enum.GetValues<MealDay>()) {
    <section class="meal-day @(day == today ? "is-today" : null)" aria-current="@(day == today ? "date" : null)" @key="day">
        <header class="day-heading"><h3>@day</h3>@if (day == today) { <span class="today-badge">Today</span> }</header>
        @foreach (var time in enabledSlots) {
            <div class="meal-slot">
                <h4>@time</h4>
                @foreach (var entry in entries.Where(x => x.Day == day && x.Time == time)) {
                    <div class="planned-meal" @key="(entry.Id, revision)">
                        <label class="sr-only" for="entry-@entry.Id">Replace @entry.Name on @day @time</label>
                        <select id="entry-@entry.Id" value="@entry.MealId" @onchange="e => Replace(entry, e)" disabled="@busy">
                            @foreach (var meal in meals) { <option value="@meal.Id">@meal.Name</option> }
                        </select>
                        <BbButton OnClick="() => Remove(entry.Id)" Disabled="busy" aria-label="@($"Remove {entry.Name} from {day} {time}")">Remove</BbButton>
                    </div>
                }
                <label class="sr-only" for="add-@day-@time">Add meal to @day @time</label>
                <select @key="(day, time, revision)" id="add-@day-@time" value="" @onchange="e => Add(day, time, e)" disabled="@(busy || meals.Count == 0)">
                    <option value="">Add a meal…</option>
                    @foreach (var meal in meals.Where(m => !entries.Any(x => x.Day == day && x.Time == time && x.MealId == m.Id))) {
                        <option value="@meal.Id">@meal.Name</option>
                    }
                </select>
                <div class="actions slot-actions"><BbButton OnClick="() => BeginCreate(day, time)" Disabled="busy">Create a meal</BbButton></div>
                @if (newMeal is not null && newMeal.Day == day && newMeal.Time == time) {
                    <EditForm Model="newMeal" OnValidSubmit="Create" FormName="new-planner-meal">
                        <DataAnnotationsValidator /><ValidationSummary />
                        <label for="new-meal-name">Meal name</label>
                        <InputText id="new-meal-name" @bind-Value="newMeal.Name" maxlength="100" disabled="@busy" />
                        <p>If this name already exists, we’ll use that meal. Other meals in this slot will stay.</p>
                        <div class="actions"><BbButton Type="ButtonType.Submit" Disabled="busy">Save and add meal</BbButton>
                        <BbButton OnClick="() => newMeal = null" Disabled="busy">Cancel</BbButton></div>
                    </EditForm>
                }
            </div>
        }
    </section>
}
</div>
</fieldset>
@code {
    private bool interactiveReady;
    private MealDay today = (MealDay)(((int)DateTime.Today.DayOfWeek + 6) % 7);
    private IJSObjectReference? clock;
    private IReadOnlyList<MealTime> enabledSlots = [MealTime.Dinner];
    private IReadOnlyList<PlanWeek.Entry> entries = [];
    private IReadOnlyList<HomeHub.Web.Modules.MealPlanner.ManageMeals.ManageMeals.Item> meals = [];
    private string? error;
    private string? message;
    private HomeHub.Web.Modules.MealPlanner.CreateMealFromPlanner.CreateMealFromPlanner.Request? newMeal;
    private bool busy;
    private int revision;
    protected override async Task OnInitializedAsync() => await Refresh();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) {
            clock = await JS.InvokeAsync<IJSObjectReference>("import", "./Modules/MealPlanner/PlanWeek/Index.razor.js");
            today = await clock.InvokeAsync<MealDay>("getCurrentDay");
            interactiveReady = true; StateHasChanged();
        }
    }
    private async Task Load()
    {
        var actor = (await Auth.GetAuthenticationStateAsync()).User;
        if (clock is not null) today = await clock.InvokeAsync<MealDay>("getCurrentDay");
        var settings = await Settings.GetAsync(actor);
        enabledSlots = Enum.GetValues<MealTime>().Where(time => time switch {
            MealTime.Breakfast => settings.BreakfastEnabled,
            MealTime.Lunch => settings.LunchEnabled,
            MealTime.Dinner => settings.DinnerEnabled,
            _ => false
        }).ToArray();
        if (newMeal is not null && !enabledSlots.Contains(newMeal.Time)) newMeal = null;
        meals = await MealList.ListAsync(actor);
        entries = await UseCase.GetAsync(actor);
        revision++;
    }
    private async Task Refresh() => await Run(Load);
    private async Task Add(MealDay day, MealTime time, ChangeEventArgs e) => await Set(day, time, e, null);
    private async Task Replace(PlanWeek.Entry entry, ChangeEventArgs e) => await Set(entry.Day, entry.Time, e, entry.Id);
    private async Task Set(MealDay day, MealTime time, ChangeEventArgs e, Guid? entryId) => await Run(async () => {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        await UseCase.SetAsync((await Auth.GetAuthenticationStateAsync()).User, day, time, id, entryId); await Load();
    });
    private async Task Remove(Guid id) => await Run(async () => {
        await UseCase.RemoveAsync((await Auth.GetAuthenticationStateAsync()).User, id); await Load();
    });
    private void BeginCreate(MealDay day, MealTime time)
    {
        newMeal = new() { Day = day, Time = time }; error = null; message = null;
    }
    private async Task Create() => await Run(async () => {
        if (newMeal is null) return;
        var result = await CreateMeal.RunAsync((await Auth.GetAuthenticationStateAsync()).User, newMeal);
        message = result.AlreadyPlanned ? $"{result.Name} is already in this slot."
            : result.Reused ? $"Added existing meal {result.Name} to the plan." : $"Created {result.Name} and added it to the plan.";
        newMeal = null; await Load();
    });
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; error = null; message = null;
        try { await action(); }
        catch (HouseholdRuleException ex) { error = ex.Message; }
        finally { busy = false; revision++; }
    }
    public async ValueTask DisposeAsync()
    {
        if (clock is null) return;
        try { await clock.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
