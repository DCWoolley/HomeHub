@page "/Home/Members/Remove/{MemberId:guid}"
@layout HomeHub.Web.Components.Layout.AppLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using HomeHub.Application.Features.Homes.ManageMembers
@inject IHomeMembers Homes
@inject NavigationManager Navigation

<PageTitle>Remove member | HomeHub</PageTitle>
<AccountCard Title="Remove member" Description="Review this change before confirming.">
    @if (error is not null)
    {
        <p class="validation-message" role="alert">@error</p>
    }
    @if (member is not null)
    {
        <p>Remove <strong>@member.DisplayName</strong> from your home?</p>
        <p>@(member.IsAccountLinked ? "Their account will remain, but they will lose access to this home immediately." : "This non-user profile will be retired.") Past references will be kept. They will no longer appear for new assignments.</p>
        <EditForm Model="Input" method="post" FormName="remove-member" OnSubmit="RemoveMember">
            <label class="remember-me"><InputCheckbox @bind-Value="Input.Confirmed" /> I confirm removal of @member.DisplayName.</label>
            <button class="btn-danger" type="submit">Remove member</button>
        </EditForm>
    }
    <p class="account-links"><a href="Home/Members">Cancel and return to members</a></p>
</AccountCard>

@code {
    [Parameter] public Guid MemberId { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private RemovalInput Input { get; set; } = default!;
    private MemberDetails? member;
    private string? error;
    private string UserId => HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        var home = await Homes.GetMembersAsync(UserId, HttpContext.RequestAborted);
        member = home?.IsOwner == true ? home.Members.SingleOrDefault(item => item.Id == MemberId && !item.IsOwner) : null;
        if (member is null) error = "Only the owner can remove another active member of this home.";
    }

    private async Task RemoveMember()
    {
        if (member is null) return;
        if (!Input.Confirmed) { error = "Confirm the named member's removal first."; return; }
        error = await Homes.RemoveMemberAsync(UserId, MemberId, HttpContext.RequestAborted);
        if (error is null) Navigation.NavigateTo("Home/Members");
    }

    public sealed class RemovalInput { public bool Confirmed { get; set; } }
}
