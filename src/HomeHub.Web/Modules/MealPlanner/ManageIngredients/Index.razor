@page "/Ingredients"
@attribute [Authorize]
@layout AppLayout
@using HomeHub.Web.Modules.Households
@using HomeHub.Web.Modules.MealPlanner.Shared
@using System.Globalization
@inject ManageIngredients UseCase
@inject AuthenticationStateProvider Auth
@inject ILogger<Index> Logger

<PageTitle>Ingredients</PageTitle>
<div class="catalog-heading"><div><p class="eyebrow">Your household cookbook</p><h1>Your ingredients</h1><p>Package details, ready for every recipe.</p></div><a href="/Meals">Meal list →</a></div>
<fieldset class="catalog-controls ingredient-controls" disabled="@(!interactiveReady || busy)" aria-label="Ingredient management">
    <div class="catalog-toolbar"><div><label for="ingredient-search">Search ingredients</label><input id="ingredient-search" type="search" @bind="search" @bind:event="oninput" placeholder="Find an ingredient…" /></div><BbButton OnClick="Add">Add ingredient</BbButton></div>
    @if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
    @if (notice is not null) { <p role="status">@notice</p> }
    <p class="catalog-count">@ingredients.Count ingredient@(ingredients.Count == 1 ? "" : "s")</p>
    @if (ingredients.Count == 0) { <p class="catalog-empty">No ingredients yet. Add your first ingredient to get started.</p> }
    else if (!Filtered.Any()) { <p class="catalog-empty" role="status">No ingredients match your search.</p> }
    <div class="catalog-list">
        @foreach (var ingredient in Filtered) {
            <article class="catalog-entry" @key="ingredient.Id"><div><h2>@ingredient.Name</h2><p>Amount per package: @Format(ingredient.Amount) @ingredient.Unit</p><span class="catalog-price">@(ingredient.PackagePrice is { } price ? price.ToString("C2", CultureInfo.GetCultureInfo("en-GB")) : "Price unknown")</span></div>
                <div class="actions"><BbButton Variant="ButtonVariant.Outline" Class="secondary" OnClick="() => Edit(ingredient)">Edit</BbButton><BbButton Variant="ButtonVariant.Outline" Class="secondary" OnClick="() => pending = ingredient">Delete</BbButton></div>
            </article>
        }
    </div>
    @if (pending is not null) {
        <section class="alert" aria-label="Confirm ingredient deletion"><p>Delete <strong>@pending.Name</strong>? Ingredients used in recipes must first be removed from those recipes.</p><div class="actions"><BbButton OnClick="Delete">Confirm deletion</BbButton><BbButton Variant="ButtonVariant.Outline" Class="secondary" OnClick="() => pending = null">Cancel deletion</BbButton></div></section>
    }
</fieldset>
@if (input is not null) { <IngredientEditor Input="input" Saved="Saved" Closed="() => input = null" /> }

@code {
    private bool interactiveReady;
    private bool busy;
    private string search = "";
    private string? error;
    private string? notice;
    private ManageIngredients.Request? input;
    private IReadOnlyList<ManageIngredients.Item> ingredients = [];
    private ManageIngredients.Item? pending;
    private IEnumerable<ManageIngredients.Item> Filtered => ingredients.Where(x => x.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));
    private static string Format(decimal value) => value.ToString("0.####", CultureInfo.CurrentCulture);
    protected override async Task OnInitializedAsync() => await Refresh();
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { interactiveReady = true; StateHasChanged(); } }
    private void Add() { input = new(); pending = null; error = notice = null; }
    private void Edit(ManageIngredients.Item item) { input = new() { Id = item.Id, Name = item.Name, UnitId = item.UnitId, Amount = Format(item.Amount), PackagePrice = item.PackagePrice?.ToString("0.00", CultureInfo.CurrentCulture) }; pending = null; error = notice = null; }
    private async Task Refresh() => await Run(async () => ingredients = await UseCase.ListAsync((await Auth.GetAuthenticationStateAsync()).User));
    private async Task Saved(Guid id) { input = null; await Refresh(); notice = "Ingredient saved."; }
    private async Task Delete() => await Run(async () => {
        if (pending is null) return;
        var actor = (await Auth.GetAuthenticationStateAsync()).User;
        await UseCase.DeleteAsync(actor, pending.Id); pending = null;
        ingredients = await UseCase.ListAsync(actor); notice = "Ingredient deleted.";
    });
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; error = null;
        try { await action(); }
        catch (HouseholdRuleException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Could not update ingredient list."); error = "Could not update the list. Please refresh the page and try again."; }
        finally { busy = false; }
    }
}
