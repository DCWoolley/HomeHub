@page "/Account/Manage/DeletePersonalData"
@using Microsoft.AspNetCore.Identity
@inject DeleteAccount UseCase
@inject SignInManager<ApplicationUser> SignIn
@inject IdentityRedirectManager Redirect
<PageTitle>Delete account</PageTitle>
<h1>Delete your account</h1>
<p>Leave your household first. Owners must transfer ownership before leaving.</p>
<p>Deleting your account is permanent.</p>
@if (error is not null) { <p role="alert" class="alert alert-danger">@error</p> }
<EditForm Model="Input" method="post" FormName="delete-user" OnValidSubmit="Delete">
    <DataAnnotationsValidator />
    <label for="delete-password">Confirm your password</label><InputText id="delete-password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
    <div class="actions"><button type="submit">Delete account permanently</button></div>
</EditForm>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;
    private string? error;
    protected override void OnInitialized() => Input ??= new();
    private async Task Delete()
    {
        error = await UseCase.RunAsync(HttpContext.User, Input.Password, HttpContext.RequestAborted);
        if (error is not null) return;
        await SignIn.SignOutAsync();
        Redirect.RedirectTo("/");
    }
    private sealed class InputModel { [Required] public string Password { get; set; } = ""; }
}
