@page "/Meals/{MealId:guid}/Recipe"
@attribute [Authorize]
@layout AppLayout
@using System.Globalization
@using HomeHub.Web.Modules.Households
@using HomeHub.Web.Modules.MealPlanner.ManageIngredients
@inject ManageRecipe UseCase
@inject ManageIngredients Ingredients
@inject AuthenticationStateProvider Auth
<PageTitle>@(recipe is null ? "Meal recipe" : recipe.Name + " recipe")</PageTitle>
<h1>@(recipe is null ? "Meal recipe" : recipe.Name + " recipe")</h1>
<p><a href="/Meals">Back to meal list</a> · <a href="/Ingredients">Manage ingredients</a></p>
<p>Enter recipe quantities in each ingredient's unit. For Pasta with a 500-gram packet, a quantity of 250 grams uses half the packet. Use up to four decimal places.</p>
@if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
@if (notice is not null) { <p role="status">@notice</p> }
<fieldset class="recipe-controls" disabled="@(!interactiveReady || busy)" aria-label="Recipe management">
<BbButton OnClick="Refresh" Disabled="busy">Refresh recipe</BbButton>
@if (recipe is not null) {
    @if (ingredients.Count == 0) {
        <p>No ingredients yet. <a href="/Ingredients">Add ingredients</a> before building this recipe.</p>
    } else {
        <EditForm Model="input" OnValidSubmit="Save" FormName="recipe-item">
            <DataAnnotationsValidator /><ValidationSummary />
            <label for="recipe-ingredient">Ingredient</label>
            <InputSelect id="recipe-ingredient" @bind-Value="input.IngredientId" disabled="@(busy || editing)">
                <option value="">Choose an ingredient</option>
                @foreach (var ingredient in ingredients) {
                    <option value="@ingredient.Id">@ingredient.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="() => input.IngredientId" />
            <label for="recipe-quantity">Quantity@(SelectedIngredient is { } selected ? $" ({selected.Unit})" : "")</label>
            <InputText id="recipe-quantity" @bind-Value="input.Quantity" inputmode="decimal" maxlength="32" aria-describedby="quantity-help" disabled="@busy" />
            <small id="quantity-help">
                @if (SelectedIngredient is { } ingredient) {
                    <span>Amount per package: @Format(ingredient.Amount) @ingredient.Unit. Enter the recipe's amount in @ingredient.Unit, for example @Format(0.5m).</span>
                } else { <span>Choose an ingredient to see its unit.</span> }
            </small>
            <ValidationMessage For="() => input.Quantity" />
            <div class="actions"><BbButton Type="ButtonType.Submit" Disabled="busy">@(editing ? "Save quantity" : "Add ingredient")</BbButton>
            @if (editing) { <BbButton OnClick="Cancel" Disabled="busy">Cancel edit</BbButton> }</div>
        </EditForm>
    }
    @if (recipe.Items.Count == 0) { <p>This meal has no recipe items yet. Add an ingredient and quantity above.</p> }
    @foreach (var item in recipe.Items) {
        <div class="card" @key="item.IngredientId">
            <strong>@item.Name</strong><span>Quantity: @Format(item.Quantity) @item.Unit</span>
            <div class="actions"><BbButton OnClick="() => Edit(item)" Disabled="busy">Edit quantity</BbButton>
            <BbButton OnClick="() => Remove(item.IngredientId)" Disabled="busy">Remove</BbButton></div>
        </div>
    }
}
</fieldset>
@code {
    [Parameter] public Guid MealId { get; set; }
    private bool interactiveReady;
    private bool busy;
    private bool editing;
    private string? error;
    private string? notice;
    private ManageRecipe.Recipe? recipe;
    private IReadOnlyList<ManageIngredients.Item> ingredients = [];
    private ItemInput input = new();
    private ManageIngredients.Item? SelectedIngredient => ingredients.FirstOrDefault(x => x.Id == input.IngredientId);
    private sealed class ItemInput
    {
        [Required(ErrorMessage = "Choose an ingredient.")] public Guid? IngredientId { get; set; }
        [Required(ErrorMessage = "Enter a quantity.")] public string Quantity { get; set; } = "";
    }
    private static string Format(decimal quantity) => quantity.ToString("0.####", CultureInfo.CurrentCulture);
    protected override async Task OnParametersSetAsync()
    {
        recipe = null; ingredients = []; Cancel(); await Refresh();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { interactiveReady = true; StateHasChanged(); }
    }
    private async Task Load()
    {
        var actor = (await Auth.GetAuthenticationStateAsync()).User;
        recipe = await UseCase.GetAsync(actor, MealId);
        ingredients = await Ingredients.ListAsync(actor);
    }
    private async Task Refresh() => await Run(async () => { await Load(); Cancel(); });
    private void Cancel() { input = new(); editing = false; }
    private void Edit(ManageRecipe.Item item)
    {
        input = new() { IngredientId = item.IngredientId, Quantity = Format(item.Quantity) };
        editing = true; error = null; notice = null;
    }
    private async Task Save() => await Run(async () => {
        if (SelectedIngredient is not { } selected) throw new HouseholdRuleException("Refresh the recipe and choose an ingredient.");
        await UseCase.SaveAsync((await Auth.GetAuthenticationStateAsync()).User, MealId, selected.Id, input.Quantity, editing, expectedUnitId: selected.UnitId);
        Cancel(); await Load(); notice = "Recipe saved.";
    });
    private async Task Remove(Guid ingredientId) => await Run(async () => {
        await UseCase.RemoveAsync((await Auth.GetAuthenticationStateAsync()).User, MealId, ingredientId);
        Cancel(); await Load(); notice = "Ingredient removed from recipe.";
    });
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; error = null; notice = null;
        try { await action(); }
        catch (HouseholdRuleException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
