@page "/MealPlanner"
@inject IMealPlanner Planner
@inject IMeals Meals
@inject IHomeMembers Members

<PageTitle>Meal planner | HomeHub</PageTitle>
<AccountCard Wide="true" Title="Meal planner" Description="One shared Monday–Friday plan for your household, repeated each week.">
    @if (error is not null) { <p role="alert" class="validation-message">@error</p> }
    @if (plan is null)
    {
        <p><a href="Home">Create or join a home</a> to start planning.</p>
    }
    else
    {
        <p><a href="Meals">Manage meals</a></p>
        <div class="week-plan">
            @foreach (var day in Weekdays)
            {
                <section class="day-card">
                    <h2>@day</h2>
                    @if (!plan.Any(entry => entry.Day == day)) { <p>No meals planned.</p> }
                    @foreach (var entry in plan.Where(entry => entry.Day == day))
                    {
                        <article>
                            <h3>@entry.Name</h3>
                            <p>@(entry.MemberIds.Count == 0 ? "Everyone" : string.Join(", ", entry.MemberIds.Select(id => members?.Members.FirstOrDefault(member => member.Id == id)?.DisplayName ?? "Former member")))</p>
                            <a href="MealPlanner/Entry/@entry.Id">Members / remove</a>
                        </article>
                    }
                </section>
            }
        </div>
        @if (meals?.Count > 0)
        {
            <h2>Add to the plan</h2>
            <EditForm Model="Input" method="post" FormName="plan-meal" OnValidSubmit="Add">
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <div class="form-field">
                    <label for="plan-meal">Meal</label>
                    <InputSelect id="plan-meal" class="form-control" @bind-Value="Input.MealId">
                        <option value="">Choose a meal</option>
                        @foreach (var meal in meals) { <option value="@meal.Id">@meal.Name</option> }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label for="plan-day">Day</label>
                    <InputSelect id="plan-day" class="form-control" @bind-Value="Input.Day">
                        @foreach (var day in Weekdays) { <option value="@day">@day</option> }
                    </InputSelect>
                </div>
                <p>New planned meals are for everyone. Choose “Members / remove” to set exceptions.</p>
                <button type="submit">Add to plan</button>
            </EditForm>
        }
        else { <p><a href="Meals/New">Add your first meal</a> to start planning.</p> }
    }
</AccountCard>

@code {
    private static readonly DayOfWeek[] Weekdays = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday];
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "plan-meal")] private PlanInput Input { get; set; } = default!;
    private IReadOnlyList<PlannedMealDetails>? plan;
    private IReadOnlyList<MealDetails>? meals;
    private MembersDetails? members;
    private string? error;
    private string UserId => HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        plan = await Planner.GetPlanAsync(UserId, HttpContext.RequestAborted);
        meals = await Meals.GetMealsAsync(UserId, HttpContext.RequestAborted);
        members = await Members.GetMembersAsync(UserId, HttpContext.RequestAborted);
    }
    private async Task Add()
    {
        error = await Planner.AddMealAsync(UserId, Input.MealId ?? Guid.Empty, Input.Day, HttpContext.RequestAborted);
        if (error is null) HttpContext.Response.Redirect("/MealPlanner");
    }
    public sealed class PlanInput
    {
        [Required(ErrorMessage = "Choose a meal.")] public Guid? MealId { get; set; }
        public DayOfWeek Day { get; set; } = DayOfWeek.Monday;
    }
}
